# Python
/__pycache__
**/__pycache__/
*.pyc
*.exe
/.venv
# Separate environment for the GPU experiment (torch+CUDA pulls numpy>=2,
# which is incompatible with the mediapipe pin in the main .venv).
/.venv-dl

# Large binaries (models & video) — keep out of the repo
*.mp4
*.pt
*.task
hand_landmarker.task

# Trained boundary scorer. Deliberately NOT committed: a pickled scikit-learn
# estimator is tied to the version that created it, and loading it under a
# different version raises InconsistentVersionWarning and may silently change
# results. It is cheap to regenerate and fully reproducible:
#     python train_boundary_model.py --src .
# The JSON sidecar (blend weight + provenance) IS committed, since it is plain
# text and records how the model was configured.
boundary_model.joblib

